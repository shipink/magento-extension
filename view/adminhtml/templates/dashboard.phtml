<?php
/** @var \Shipink\Shipink\Block\Adminhtml\Dashboard $block */
/** @var \Magento\Framework\Escaper $escaper */
?>
<div class="shipink-dashboard">
    <?php if ($block->isConnected()): ?>
        <?php $connectedText = __('This store is connected to Shipink since %1 (UTC).', $block->getConnectedAt()); ?>
        <p><?= $escaper->escapeHtml($connectedText) ?></p>
        <p>
            <a class="action-primary" target="_blank" rel="noopener noreferrer"
               href="<?= $escaper->escapeUrl($block->getDashboardUrl()) ?>">
                <?= $escaper->escapeHtml(__('Open Shipink dashboard')) ?></a>
            <?php if ($block->canConnect()): ?>
                <a class="action-secondary" href="<?= $escaper->escapeUrl($block->getConnectUrl()) ?>">
                    <?= $escaper->escapeHtml(__('Reconnect')) ?></a>
            <?php endif; ?>
        </p>
    <?php else: ?>
        <?php $introText = __(
            'Connect this store to Shipink to sync orders and print labels with discounted carrier rates.'
        ); ?>
        <p><?= $escaper->escapeHtml($introText) ?></p>
        <?php if ($block->canConnect()): ?>
            <p><a class="action-primary" href="<?= $escaper->escapeUrl($block->getConnectUrl()) ?>">
                <?= $escaper->escapeHtml(__('Connect to Shipink')) ?></a></p>
        <?php endif; ?>
    <?php endif; ?>
</div>
