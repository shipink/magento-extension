<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <virtualType name="Shipink\Shipink\Logger\Handler" type="Magento\Framework\Logger\Handler\Base">
        <arguments>
            <argument name="fileName" xsi:type="string">/var/log/shipink.log</argument>
        </arguments>
    </virtualType>
    <virtualType name="Shipink\Shipink\Logger" type="Magento\Framework\Logger\Monolog">
        <arguments>
            <argument name="name" xsi:type="string">shipink</argument>
            <argument name="handlers" xsi:type="array">
                <item name="file" xsi:type="object">Shipink\Shipink\Logger\Handler</item>
            </argument>
        </arguments>
    </virtualType>
    <type name="Shipink\Shipink\Model\WebhookSender">
        <arguments>
            <argument name="logger" xsi:type="object">Shipink\Shipink\Logger</argument>
        </arguments>
    </type>
    <type name="Shipink\Shipink\Controller\Adminhtml\Connect\Confirm">
        <arguments>
            <argument name="logger" xsi:type="object">Shipink\Shipink\Logger</argument>
        </arguments>
    </type>
</config>
